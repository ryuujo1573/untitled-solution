{
  "name": "@cnmjs/untitled-solution-root",
  "type": "module",
  "private": true,
  "license": "BSD-3-Clause",
  "workspaces": {
    "packages": [
      "packages/*",
      "services/*",
      "apps/*",
      "tools/*"
    ],
    "catalogs": {
      "front-end": {
        "@builder.io/qwik": "^1.17.2",
        "@builder.io/qwik-city": "^1.17.2",
        "@eslint/js": "^9.39.1",
        "@types/node": "^24.10.1",
        "eslint": "9.32.0",
        "eslint-plugin-qwik": "^1.17.2",
        "typescript": "5.4.5",
        "typescript-eslint": "8.38.0"
      }
    }
  },
  "packageManager": "bun@1.3.4",
  "scripts": {
    "build": "bun run --filter '*' build",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "select-model": "bun run scripts/select-ai-model.ts"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.1",
    "@types/bun": "latest",
    "@types/node": "^22.19.3",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.47.0"
  },
  "prettier": {
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf"
  },
  "dependencies": {
    "zod": "^4.1.12"
  }
}
