{
  "name": "@cnmjs/design",
  "version": "1.0.0",
  "description": "BaaS Design System",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.server": "qwik check-client src dist-bun && vite build -c adapters/bun/vite.config.ts",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.pages": "qwik check-client src dist && vite build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "qwik build && bun run build.pages && wrangler pages deploy ./dist",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "serve": "wrangler pages dev ./dist --compatibility-flags=nodejs_als",
    "start": "vite --open --mode ssr",
    "typecheck": "tsc --incremental --noEmit",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.17.2",
    "@builder.io/qwik-city": "^1.17.2",
    "@eslint/js": "latest",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@qwikest/icons": "^0.0.13",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.4",
    "@types/bun": "*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "20.19.0",
    "daisyui": "^5.5.5",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "^1.17.2",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "redux": "^5.0.1",
    "tailwindcss": "^4.1.4",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "undici": "*",
    "vite": "7.1.11",
    "vite-tsconfig-paths": "^4.2.1",
    "wrangler": "^3.0.0"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "dependencies": {
    "@cnmjs/schema": "workspace:*",
    "js-yaml": "^4.1.0",
    "monaco-editor": "^0.55.1",
    "yaml": "^2.8.2"
  }
}
