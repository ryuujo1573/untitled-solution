{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cnmjs.dev/schemas/layout-ir.json",
  "id": "LayoutIR",
  "title": "Layout IR Schema",
  "description": "A structured intermediate representation for describing UI layouts",
  "type": "object",
  "properties": {
    "version": {
      "description": "Schema version identifier",
      "type": "string"
    },
    "root": {
      "$ref": "#/$defs/LayoutNode"
    }
  },
  "required": [
    "version",
    "root"
  ],
  "additionalProperties": false,
  "$defs": {
    "LayoutNode": {
      "id": "LayoutNode",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "description": "Unique identifier for this node",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "layout"
            },
            "context": {
              "$ref": "#/$defs/LayoutContext"
            },
            "props": {
              "$ref": "#/$defs/LayoutBaseProps"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/LayoutNode"
              }
            }
          },
          "required": [
            "id",
            "type",
            "context"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "description": "Unique identifier for this node",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "component"
            },
            "category": {
              "$ref": "#/$defs/ComponentCategory"
            },
            "name": {
              "description": "Component name in format 'Namespace:ComponentName' (e.g., 'MUI:AppBar', 'Biz:StatCard')",
              "type": "string"
            },
            "props": {
              "description": "Component-specific props",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/LayoutNode"
              }
            }
          },
          "required": [
            "id",
            "type",
            "category",
            "name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "LayoutContext": {
      "id": "LayoutContext",
      "description": "Layout formatting context type",
      "type": "string",
      "enum": [
        "flex",
        "grid",
        "block",
        "scroll"
      ]
    },
    "LayoutBaseProps": {
      "id": "LayoutBaseProps",
      "description": "Layout-affecting properties only, no decorative styles",
      "type": "object",
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "row",
            "column"
          ]
        },
        "gap": {
          "$ref": "#/$defs/ResponsiveValue"
        },
        "align": {
          "type": "string"
        },
        "justify": {
          "type": "string"
        },
        "flex": {
          "$ref": "#/$defs/ResponsiveValue"
        },
        "width": {
          "$ref": "#/$defs/ResponsiveValue"
        },
        "height": {
          "$ref": "#/$defs/ResponsiveValue"
        },
        "padding": {
          "$ref": "#/$defs/ResponsiveValue"
        },
        "columns": {
          "type": "string"
        },
        "rows": {
          "type": "string"
        },
        "axis": {
          "type": "string",
          "enum": [
            "x",
            "y",
            "both"
          ]
        }
      },
      "additionalProperties": {}
    },
    "ResponsiveValue": {
      "id": "ResponsiveValue",
      "description": "Breakpoint-keyed responsive values (e.g., { base: '100%', lg: '240px' })",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          }
        }
      ]
    },
    "ComponentCategory": {
      "id": "ComponentCategory",
      "description": "Component classification for visualization",
      "type": "string",
      "enum": [
        "reusable",
        "library",
        "new",
        "primitive"
      ]
    }
  }
}